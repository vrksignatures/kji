<?xml version="1.0" encoding="utf-8"?>
<!--
  The folded panel: a ring and nothing else. No fill, no picture in the middle - whatever
  is behind it shows through untouched. Two hairlines a little apart, a dark one and a
  light one, so that it reads as a raised rim on a pale screen and on a dark one alike.
  The controller tints it amber when a run has stopped and green when the list is done.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1.5dp"
        android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.25dp"
                android:color="@color/ring_shade" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:right="1.5dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.25dp"
                android:color="@color/ring_light" />
        </shape>
    </item>
</layer-list>
